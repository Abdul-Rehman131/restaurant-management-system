# Copy to apps/<app>/.env.local and fill in. Never commit real values.
# Only public, browser-safe values belong here (RLS protects the data). Use the
# publishable key (sb_publishable_...), never a secret or service-role key.
# The service-role key must NEVER appear in any front-end env file.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SENTRY_DSN=

# staff-app only: PWA install label on the home screen (build time, set per deployment).
# Defaults to "Staff App". The in-app restaurant name always comes from the settings table.
VITE_APP_NAME=
