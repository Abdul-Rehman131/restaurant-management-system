    "tailwind-merge": "3.7.0"
  },
  "peerDependencies": {
    "react": "^19"
  },
  "devDependencies": {
    "@rms/config": "workspace:*",
    "@types/react": "19.3.0",
    "react": "19.3.1",
    "typescript": "6.0.3",
    "vite": "8.3.5"
  }
}
