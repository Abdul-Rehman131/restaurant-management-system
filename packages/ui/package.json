{
  "name": "@rms/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./tokens.css": "./src/tokens.css",
    "./brand.css": "./src/brand.css",
    "./brand-tokens": {
      "types": "./brand-tokens.d.mts",
      "default": "./brand-tokens.mjs"
    },
    "./vite-plugin": {
      "types": "./vite-plugin.d.mts",
      "default": "./vite-plugin.mjs"
    },
    "./i18n": "./src/i18n/index.ts"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/check-contrast.mjs",
    "brand:icons": "pwa-assets-generator"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "clsx": "2.1.1",
    "tailwind-merge": "3.7.0",
    "@rms/shared": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19",
    "i18next": "^26",
    "react-i18next": "^17"
  },
  "devDependencies": {
    "@rms/config": "workspace:*",
    "@types/react": "19.3.0",
    "@vite-pwa/assets-generator": "2.0.0",
    "i18next": "26.5.7",
    "react": "19.3.1",
    "react-i18next": "17.1.5",
    "typescript": "6.0.3",
    "vite": "8.3.5"
  }
}
